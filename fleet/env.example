# /etc/fleet/<role>.env : one per box. chmod 0640, chown root:fleet. NEVER commit a real copy.
# systemd EnvironmentFile syntax: KEY=value, comments only on their own lines (no trailing "# ...").

# ---------- required everywhere ----------
# ads | quotes | scheduler | followup | host
FLEET_ROLE=quotes
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: full database access. Lives only on the boxes and in Vercel, never in a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site, used for unsubscribe links and Stripe redirect URLs.
SITE_URL=https://YOUR-SITE

# ---------- optional ----------
# Name on the Fleet panel (default "<role>-<hostname>"), e.g. W1..W4 / host.
#FLEET_NAME=W2
# Version shown on the Fleet panel (default: git HEAD of /opt/fleet).
#FLEET_VERSION=

# ---------- AI: ads, quotes, followup ----------
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5. Never a Haiku model.
#ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- quotes ----------
# none | census | nominatim | google | mapbox. census = US Census Bureau, free, no key.
#GEOCODER=census
#GEOCODER_API_KEY=
#GEOCODER_USER_AGENT=emmetts-property-services/1.0 (you@YOUR-DOMAIN)
# none | cuyahoga_gis (regrid is a stub). cuyahoga_gis needs a geocoder (or autocomplete coords) and PARCEL_GIS_URL.
#PARCEL_SOURCE=cuyahoga_gis
# The county tax-parcel layer, ending in /FeatureServer/<n> or /MapServer/<n> (docs/ENV.md: finding the layer).
#PARCEL_GIS_URL=https://gis.cuyahogacounty.gov/server/rest/services/CCFO/Parcel_Fabric_Taxparcels/FeatureServer/0
# Only if auto-detection picks the wrong attribute (names are case-insensitive):
#PARCEL_GIS_ID_FIELD=
#PARCEL_GIS_ACRES_FIELD=
#PARCEL_GIS_SQFT_FIELD=
# Only needed when quote autopilot is on (the worker then creates the Checkout link). TEST MODE ONLY.
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_TAX_ENABLED=true            # same value as Vercel (see docs/STRIPE.md)
#STRIPE_TAX_CODE=                   # same value as Vercel

# ---------- followup (and any role whose autopilot sends email) ----------
# TODO [EMAIL PROVIDER - ask owner]: log | resend | postmark   ("log" prints to the journal, sends nothing)
#EMAIL_PROVIDER=log
#EMAIL_FROM="Emmett's Property Services <hello@YOUR-DOMAIN>"
#RESEND_API_KEY=
#POSTMARK_SERVER_TOKEN=
#SMS_PROVIDER=log
# The NWS asks for a contact in the User-Agent.
#NWS_USER_AGENT=(emmetts-property-services, you@YOUR-DOMAIN)
# TODO [REVIEW LINK - ask owner]: e.g. the Google review link, used in review requests.
#REVIEW_URL=
#BUSINESS_NAME=Emmett's Property Services
