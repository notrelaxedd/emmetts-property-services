# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Full list with where each lives (Vercel vs fleet boxes): docs/ENV.md

# --- Public site ---
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (server-side only; never NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Stripe (test mode until the owner approves going live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=           # leave unset until Ohio is registered in Stripe Tax; then true
STRIPE_TAX_CODE=              # TODO [TAX CODE]: pick from `npm run stripe:setup` output; unset = account default

# --- Integrations (unknowns from the plan; leave blank until decided) ---
EMAIL_PROVIDER=log            # TODO [EMAIL PROVIDER]: log | resend | postmark | smtp
EMAIL_FROM=                   # TODO [sending domain]
RESEND_API_KEY=
GEOCODER=none                 # none | census | google | mapbox | nominatim
GEOCODER_API_KEY=
PARCEL_SOURCE=none            # fleet only: none | cuyahoga_gis (+ PARCEL_GIS_URL)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # browser-restricted Places/Maps JS key; unset = plain address box
