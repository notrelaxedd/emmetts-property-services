# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Supabase project URL (Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key (same page). Server-only: never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Your live domain once you have one, e.g. https://emmettspropertyservices.com
# Used for canonical URLs, Open Graph, sitemap, and JSON-LD. On Vercel it falls back to the production URL.
NEXT_PUBLIC_SITE_URL=
